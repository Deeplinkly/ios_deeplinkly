{
  "_comment": [
    "Single source of truth for every signal the SDK may send to /enrich.",
    "",
    "Generated into three platform files by `dart run tool/gen_signals.dart`:",
    "  <android-sdk>/deeplinkly/src/main/kotlin/com/deeplinkly/android_deeplinkly/privacy/SignalCatalogue.kt",
    "  <ios-sdk>/Sources/Deeplinkly/SignalCatalogue.swift",
    "  <backend>/links/signal_catalogue.py",
    "Run `dart run tool/gen_signals.dart --check` in CI to prove they are in sync.",
    "",
    "tier  = the LOWEST AttributionLevel at which the key still ships.",
    "        'minimal' implies it also survives 'reduced' and 'full'.",
    "        'none' never ships anything, so it is not a valid tier value.",
    "        A key absent from this file is dropped at EVERY level, including full.",
    "        That is deliberate: you cannot add a signal without classifying it.",
    "",
    "scope = where the value comes from and where it is stored.",
    "        'static'   collected once per device, cached, re-collected on stamp change.",
    "        'dynamic'  collected fresh at send time; never persisted in a queue.",
    "        'identity' names the link/user being reported on, not the device.",
    "                   Never routed into the dynamic sample table.",
    "",
    "platforms = omit for both. Present only to keep the generated tables honest.",
    "",
    "Bump catalogue_version whenever this file changes: it is part of the static",
    "profile stamp, and without it a signal added in a patch release is never",
    "collected on devices whose app version did not change."
  ],

  "catalogue_version": 7,

  "signals": {
    "deeplinkly_device_id":  { "tier": "minimal", "scope": "static",   "type": "string" },
    "install_instance_id":   { "tier": "minimal", "scope": "static",   "type": "string" },
    "platform":              { "tier": "minimal", "scope": "static",   "type": "string" },
    "app_id":                { "tier": "minimal", "scope": "static",   "type": "string" },
    "app_version":           { "tier": "minimal", "scope": "static",   "type": "string" },
    "app_build_number":      { "tier": "minimal", "scope": "static",   "type": "string" },
    "installed_at":          { "tier": "minimal", "scope": "static",   "type": "datetime" },
    "sdk_version":           { "tier": "minimal", "scope": "static",   "type": "string" },
    "static_profile_version":{ "tier": "minimal", "scope": "static",   "type": "string" },

    "os_version":            { "tier": "reduced", "scope": "static",   "type": "string" },
    "sdk_int":               { "tier": "reduced", "scope": "static",   "type": "int",
                               "platforms": ["android"] },
    "installer_package":     { "tier": "reduced", "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "first_app_version":     { "tier": "reduced", "scope": "static",   "type": "string" },
    "first_open_at":         { "tier": "reduced", "scope": "static",   "type": "datetime" },
    "environment":           { "tier": "reduced", "scope": "static",   "type": "string" },
    "device_class":          { "tier": "reduced", "scope": "static",   "type": "string" },
    "is_hardware_id_real":   { "tier": "reduced", "scope": "static",   "type": "bool" },
    "is_emulator":           { "tier": "reduced", "scope": "static",   "type": "bool" },
    "referrer_click_at":     { "tier": "reduced", "scope": "static",   "type": "datetime",
                               "platforms": ["android"] },
    "install_begin_at":      { "tier": "reduced", "scope": "static",   "type": "datetime",
                               "platforms": ["android"] },
    "google_play_instant":   { "tier": "reduced", "scope": "static",   "type": "bool",
                               "platforms": ["android"] },
    "referrer_install_version": { "tier": "reduced", "scope": "static", "type": "string",
                               "platforms": ["android"] },

    "manufacturer":          { "tier": "full",    "scope": "static",   "type": "string" },
    "brand":                 { "tier": "full",    "scope": "static",   "type": "string" },
    "device":                { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "product":               { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "device_model":          { "tier": "full",    "scope": "static",   "type": "string" },
    "screen_width":          { "tier": "full",    "scope": "static",   "type": "int" },
    "screen_height":         { "tier": "full",    "scope": "static",   "type": "int" },
    "screen_dpi":            { "tier": "full",    "scope": "static",   "type": "int" },
    "pixel_ratio":           { "tier": "full",    "scope": "static",   "type": "float" },
    "hardware_concurrency":  { "tier": "full",    "scope": "static",   "type": "int" },
    "cpu_abi":               { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "cpu_type":              { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["ios"] },
    "os_build_id":           { "tier": "full",    "scope": "static",   "type": "string" },
    "android_id":            { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "idfv":                  { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["ios"] },
    "app_set_id":            { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "app_set_id_scope":      { "tier": "full",    "scope": "static",   "type": "string",
                               "platforms": ["android"] },
    "webview_user_agent":    { "tier": "full",    "scope": "static",   "type": "string",
                               "max_len": 512 },

    "collected_at":          { "tier": "minimal", "scope": "dynamic",  "type": "datetime" },
    "last_opened_at":        { "tier": "minimal", "scope": "dynamic",  "type": "datetime" },
    "session_id":            { "tier": "minimal", "scope": "dynamic",  "type": "string" },
    "attribution_level":     { "tier": "minimal", "scope": "dynamic",  "type": "string" },
    "att_status":            { "tier": "minimal", "scope": "dynamic",  "type": "string",
                               "platforms": ["ios"] },
    "android_reported_at":   { "tier": "reduced", "scope": "dynamic",  "type": "string",
                               "platforms": ["android"] },
    "ios_reported_at":       { "tier": "reduced", "scope": "dynamic",  "type": "string",
                               "platforms": ["ios"] },
    "locale":                { "tier": "reduced", "scope": "dynamic",  "type": "string" },
    "language":              { "tier": "reduced", "scope": "dynamic",  "type": "string" },
    "region":                { "tier": "reduced", "scope": "dynamic",  "type": "string" },
    "timezone":              { "tier": "reduced", "scope": "dynamic",  "type": "string" },
    "timezone_offset_min":   { "tier": "reduced", "scope": "dynamic",  "type": "int" },
    "connection_type":       { "tier": "reduced", "scope": "dynamic",  "type": "string" },
    "ui_mode_night":         { "tier": "reduced", "scope": "dynamic",  "type": "bool" },
    "limit_ad_tracking":     { "tier": "reduced", "scope": "dynamic",  "type": "bool" },
    "unidentified_device":   { "tier": "reduced", "scope": "dynamic",  "type": "bool" },
    "advertising_id":        { "tier": "full",    "scope": "dynamic",  "type": "string",
                               "platforms": ["android"] },
    "idfa":                  { "tier": "full",    "scope": "dynamic",  "type": "string",
                               "platforms": ["ios"] },
    "device_carrier":        { "tier": "full",    "scope": "dynamic",  "type": "string",
                               "platforms": ["android"] },
    "local_ip":              { "tier": "full",    "scope": "dynamic",  "type": "string",
                               "max_len": 64 },

    "custom_user_id":        { "tier": "minimal", "scope": "identity", "type": "string" },
    "click_id":              { "tier": "minimal", "scope": "identity", "type": "string" },
    "code":                  { "tier": "minimal", "scope": "identity", "type": "string" },
    "source":                { "tier": "minimal", "scope": "identity", "type": "string" },
    "install_referrer":      { "tier": "minimal", "scope": "identity", "type": "string",
                               "platforms": ["android"] },
    "utm_source":            { "tier": "reduced", "scope": "identity", "type": "string" },
    "utm_medium":            { "tier": "reduced", "scope": "identity", "type": "string" },
    "utm_campaign":          { "tier": "reduced", "scope": "identity", "type": "string" },
    "utm_term":              { "tier": "reduced", "scope": "identity", "type": "string" },
    "utm_content":           { "tier": "reduced", "scope": "identity", "type": "string" },
    "gclid":                 { "tier": "reduced", "scope": "identity", "type": "string" },
    "fbclid":                { "tier": "reduced", "scope": "identity", "type": "string" },
    "ttclid":                { "tier": "reduced", "scope": "identity", "type": "string" }
  }
}
